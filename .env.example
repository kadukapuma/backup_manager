APP_NAME="Backup Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Backup Manager -------------------------------------------------------
# First admin, created by `php artisan db:seed` (password: 12+ characters).
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tool paths. MARIADB_BIN_DIR prefixes mariadb-dump and mariadb, e.g.
# /usr/local/apps/mariadb114/bin on Webuzo. Leave empty to use $PATH.
MARIADB_BIN_DIR=
# BM_MARIADB_DUMP_BIN=
# BM_MARIADB_BIN=
BM_ZSTD_BIN=zstd
BM_AGE_BIN=age
BM_RCLONE_BIN=rclone
BM_SHA256SUM_BIN=sha256sum
# BM_BASH_BIN=bash

# Working directories (0700). Keep them outside the web root; defaults live in storage/app/private.
# BM_STAGING_PATH=
# BM_TMP_PATH=

# age private key for restores (optional). When empty, paste the key in the restore wizard.
# Keep this file 0600, owned by the queue worker user, ideally NOT on this server.
AGE_IDENTITY_FILE=

BM_ZSTD_LEVEL=3
BM_STALE_AFTER_HOURS=26
BM_VERIFY_BY_DOWNLOAD=false

# Security
BM_IP_ALLOWLIST=
BM_REQUIRE_2FA=false
# Comma-separated proxy IPs (or *) when running behind a reverse proxy / Cloudflare.
BM_TRUSTED_PROXIES=

# Queues and timeouts (seconds)
BM_QUEUE_BACKUPS=backups
BM_QUEUE_RESTORES=restores
BM_QUEUE_DEFAULT=default
BM_BACKUP_TIMEOUT=21600
BM_RESTORE_TIMEOUT=21600
BM_LOCK_SECONDS=28800
BM_LOCK_WAIT_ATTEMPTS=30
BM_LOCK_WAIT_SECONDS=60

# Shown in manifests when the app is deployed without .git
# APP_VERSION=
# Must be larger than BM_BACKUP_TIMEOUT / BM_RESTORE_TIMEOUT
DB_QUEUE_RETRY_AFTER=23000
REDIS_QUEUE_RETRY_AFTER=23000
